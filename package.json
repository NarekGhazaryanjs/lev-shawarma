{
  "name": "lev-shawarma",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 5000 --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "node server.js",
    "start:next": "next start --hostname 127.0.0.1",
    "setup": "node scripts/setup.mjs",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "prestart": "node -e \"const fs=require('fs'); if(!fs.existsSync('.next')) { console.error('Run npm run build first'); process.exit(1); }\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "iron-session": "^8.0.4",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
